<?xml version="1.0"?>
<!--
  CarbonMobile city-scale edge topology.
  8 edge datacenters spread across a ~50 km x 50 km city.
  Coordinates are in meters; (0,0) is the south-west corner.

  Each edge has 1 host with 2 VMs (8-core, 10000 MIPS),
  except the downtown hub (id=2) which has 4 VMs.

  attractiveness:
    0 = high-traffic hub (downtown / business district)
    1 = medium (residential / commercial mix)
    2 = low (suburb / industrial)
-->
<edge_devices>
  <datacenter arch="x86" os="Linux" vmm="Xen">
    <costPerBw>0.1</costPerBw>
    <costPerSec>3.0</costPerSec>
    <costPerMem>0.05</costPerMem>
    <costPerStorage>0.1</costPerStorage>
    <location>
      <x_pos>5000</x_pos>
      <y_pos>5000</y_pos>
      <wlan_id>0</wlan_id>
      <attractiveness>2</attractiveness>
    </location>
    <hosts>
      <host>
        <core>8</core>
        <mips>40000</mips>
        <ram>32000</ram>
        <storage>200000</storage>
        <VM vmm="Xen"><core>4</core><mips>10000</mips><ram>16000</ram><storage>100000</storage></VM>
        <VM vmm="Xen"><core>4</core><mips>10000</mips><ram>16000</ram><storage>100000</storage></VM>
      </host>
    </hosts>
  </datacenter>

